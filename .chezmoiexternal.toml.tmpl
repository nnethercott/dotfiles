[".antidote"]
  type = "archive"
  url = "https://github.com/mattmc3/antidote/archive/refs/heads/main.tar.gz"
  exact = true
  stripComponents = 1
  refreshPeriod = "168h"

{{ if .tmux }}
[".tmux/plugins/tpm"]
  type = "archive"
